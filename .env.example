# DOOF v0.2 Alpha — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env or .env.local to version control.

# ============================================================
# BACKEND (Python API server)
# ============================================================

# Supabase — leave blank to use local JSON files (default)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# API server
DOOF_API_HOST=127.0.0.1
DOOF_API_PORT=8765

# ============================================================
# FRONTEND (Vite / React)
# ============================================================

# Supabase — leave blank for local-only mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API endpoint the frontend connects to
VITE_API_URL=http://127.0.0.1:8765

# ============================================================
# AUTH (desktop login)
# ============================================================
# When SUPABASE_URL + an anon key are set above, login uses Supabase
# password auth.  Otherwise a local JSON profile store is used
# (data/profiles.json).  First signed-up account becomes OWNER;
# later accounts become TRUSTED users sharing the same brain.
# Google / X OAuth buttons are placeholders wired when enabled here.
# DOOF_JWT_SECRET=
# DOOF_GOOGLE_CLIENT_ID=
# DOOF_GOOGLE_CLIENT_SECRET=
# DOOF_X_CLIENT_ID=
# DOOF_X_CLIENT_SECRET=

# ============================================================
# NOTES
# ============================================================
# Roles: owner, trusted, viewer
# First account created is always OWNER.
# OWNER can invite TRUSTED users who share memory and training.
# VIEWER users can chat but cannot edit memory or trigger training.
