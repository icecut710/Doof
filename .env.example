# DOOF v0.2 Alpha — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env or .env.local to version control.

# ============================================================
# BACKEND (Python API server)
# ============================================================

# Supabase — leave blank to use local JSON files (default)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# API server
DOOF_API_HOST=127.0.0.1
DOOF_API_PORT=8765

# ============================================================
# FRONTEND (Vite / React)
# ============================================================

# Supabase — leave blank for local-only mode
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API endpoint the frontend connects to
VITE_API_URL=http://127.0.0.1:8765

# ============================================================
# AUTH (desktop login)
# ============================================================
# When SUPABASE_URL + SUPABASE_ANON_KEY are set, DOOF uses real
# Supabase Auth (email verification + Google OAuth).
# Otherwise a local JSON profile store is used (AppData/DOOF or data/).
#
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:      http://127.0.0.1:8766
#   Redirect URLs: http://127.0.0.1:8766/**
#                  http://127.0.0.1:8766/
#                  http://localhost:3000/**
#                  http://127.0.0.1:3000/**
#
# Enable Google under Authentication → Providers (Google Cloud OAuth client).
# The Google button only appears in the UI when SUPABASE_* are configured.
#
# Packaged EXE loads .env from (first match):
#   1) folder next to DOOF.exe
#   2) %LOCALAPPDATA%\DOOF\.env
#   3) bundled copy (read-only)

# ============================================================
# NOTES
# ============================================================
# Roles: owner, trusted, viewer
# First account created is always OWNER.
# Confirmation emails must be opened on the same PC running DOOF.
# Rate-limited email sends show a clear message + suggest Google.
