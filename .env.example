# DOOF v0.2.1 — Environment Variables
# Copy this file to .env next to DOOF.exe or into %LOCALAPPDATA%\DOOF\.env

# ============================================================
# BACKEND
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Aliases also accepted: DOOF_SUPABASE_URL / DOOF_SUPABASE_ANON_KEY

DOOF_API_HOST=0.0.0.0
DOOF_API_PORT=8765

# Optional: external model registry JSON URL (bypasses DB if set)
# DOOF_MODEL_REGISTRY_URL=https://example.com/model_registry.json

# Optional: preferred model ID (default: doof-base)
# DOOF_MODEL_ID=doof-base

# Optional cloud brain fallback (never required)
# XAI_API_KEY=
# DOOF_XAI_MODEL=grok-4.5

# Low-end / CPU-only
# DOOF_LOW_END=1
# DOOF_FORCE_CPU=1
# DOOF_DISABLE_TORCH=1
# DOOF_SOFTWARE_RENDERING=1

# ============================================================
# FRONTEND
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8765

# ============================================================
# AUTH
# ============================================================
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:      http://127.0.0.1:8766
#   Redirect URLs: http://127.0.0.1:8766/**
#                  http://127.0.0.1:8766/
#                  http://localhost:3000/**
#                  http://127.0.0.1:3000/**
#
# Enable Google under Authentication → Providers.
# The Google button is always shown in one of three states:
#   available / temporarily unavailable / not configured
